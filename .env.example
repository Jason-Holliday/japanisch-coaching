# SMTP-Zugangsdaten des Mailanbieters (IONOS, GMX, Gmail, Hostinger, ...).
# Diese Werte werden ausschliesslich serverseitig gelesen und nie an den
# Browser ausgeliefert. Niemals mit dem NEXT_PUBLIC_-Prefix benennen!
# Echte Werte gehoeren in .env.local (nicht committen).

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Postfach, das die Bewerbungen empfaengt.
CONTACT_EMAIL=

# Optional: Absenderadresse, falls SMTP_USER keine E-Mail-Adresse ist
# (manche Anbieter nutzen einen reinen Login-Namen).
# Standard: der Wert von SMTP_USER.
SMTP_FROM=

# Optional: TLS-Modus erzwingen. Ohne diese Variable gilt
# Port 465 => implizites TLS, alle anderen Ports => STARTTLS.
# SMTP_SECURE=true

# Öffentliche Domain der Live-Seite (ohne Schrägstrich am Ende).
# Wird für Sitemap, robots.txt und Canonical-URLs genutzt. Ohne diesen Wert
# wird die Seite für Suchmaschinen gesperrt (noindex) – gewollt für Tests.
NEXT_PUBLIC_SITE_URL=

# Meta-Pixel-ID aus dem Meta Events Manager (nur die Zahl). Kein Geheimnis –
# sie ist nach Zustimmung im Browser sichtbar. Beim Hosting nur für
# "Production" setzen, damit Tests keine Daten an Meta senden. Wird beim Build
# eingesetzt: nach einer Änderung neu deployen. Ohne Wert erscheint der
# Cookie-Hinweis trotzdem, es wird aber kein Pixel geladen.
NEXT_PUBLIC_META_PIXEL_ID=
